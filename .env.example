# Copy to .env for local development. Never commit real values.
# Staging and production read these from Google Secret Manager.

# dev | test | staging | prod
ENV=dev

# The API connects as a role that does NOT own the tables and has no BYPASSRLS.
DATABASE_URL=postgresql+psycopg://cm_app:cm_app@localhost:5432/companymgmt
# Migrations run as the owner role.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://cm_owner:cm_owner@localhost:5432/companymgmt
APP_DB_ROLE=cm_app

# The web app's address (used in email links) and allowed browser origins (comma-separated).
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Ed25519 private key in PEM for access tokens. Generate with: scripts/gen-keys.sh
# Empty in dev/test means a fresh key per process. Required in staging/prod.
JWT_PRIVATE_KEY=
# Optional: derived from the private key when empty.
JWT_PUBLIC_KEY=

# Field encryption keys as JSON {"key id": "base64 of 32 random bytes"}. Required in staging/prod.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=k1

# console | memory | smtp
EMAIL_BACKEND=console
# smtps://user:password@host:465 (or smtp://… with STARTTLS)
SMTP_URL=
MAIL_FROM=CompanyMgmt <no-reply@localhost>

# Cloudflare Turnstile secret. Empty disables the challenge (rate limits still apply).
TURNSTILE_SECRET=

# Shared secret Cloud Scheduler sends to /internal/* as X-Internal-Token.
INTERNAL_TOKEN=

# Behind Cloud Run / Cloudflare, trust X-Forwarded-For for the client IP.
TRUST_PROXY_HEADERS=false

SENTRY_DSN=
